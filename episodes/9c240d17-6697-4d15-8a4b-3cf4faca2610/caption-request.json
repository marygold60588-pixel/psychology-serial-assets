  "cues": [
    {
      "start": 0.0,
      "end": 3.5,
      "style": "hook",
      "text": "ОНА ОТСТРАНЯЕТСЯ ПЕРВОЙ —\nЧТОБЫ НЕ БЫТЬ ОТВЕРГНУТОЙ"
    },
    {
      "start": 3.5,
      "end": 7.5,
      "style": "body",
      "text": "Он делает маленький шаг\nк близости."
    },
    {
      "start": 7.5,
      "end": 11.5,
      "style": "body",
      "text": "Она почти автоматически\nувеличивает дистанцию."
    },
    {
      "start": 11.5,
      "end": 15.5,
      "style": "body",
      "text": "Не потому, что\nне хочет быть рядом."
    },
    {
      "start": 15.5,
      "end": 21.5,
      "style": "body",
      "text": "Близость делает возможный\nотказ слишком болезненным."
    },
    {
      "start": 21.5,
      "end": 25.0,
      "style": "body",
      "text": "Иногда страх отказа —\nэто желание уйти первой."
    },
    {
      "start": 21.5,
      "end": 25.0,
      "style": "foot",
      "text": "Практика «Когда мне говорят нет» — в профиле"
    }
  ]
}
